-- Backpack Scanner Helper for Supply Crate Card
local function getSupplyCrateCardCount()
    local count = 0
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local backpackRoot = playerGui and playerGui:FindFirstChild("Main") 
        and playerGui.Main:FindFirstChild("Backpack") 
        and playerGui.Main.Backpack:FindFirstChild("Backpack")

    if backpackRoot then
        local function scanGrid(folderObject)
            if not folderObject then return end
            for _, slot in ipairs(folderObject:GetChildren()) do
                if tonumber(slot.Name) and slot:IsA("ImageButton") then
                    local itemName = slot:GetAttribute("Item")
                    if itemName == "Supply Crate Card" then
                        local countText = "1"
                        local countObj = slot:FindFirstChild("Count")
                        if countObj and countObj:IsA("TextLabel") and countObj.Visible then
                            countText = countObj.Text
                        end
                        count = count + (tonumber(countText) or 1)
                    end
                end
            end
        end

        scanGrid(backpackRoot:FindFirstChild("Frame"))
        scanGrid(backpackRoot:FindFirstChild("Explorers"))
    end
    return count
end

-- Simulation & Detection Loop
task.spawn(function()
    while true do
        task.wait(0.5)
        if isRunning then
            local cardCount = getSupplyCrateCardCount()

            if cardCount > 25 then
                StatusLabel.Text = string.format("Status: Cards: %d (>25). Holding 'E'...", cardCount)
                
                local holdDuration = tonumber(HoldDurationBox.Text) or 2
                local delayDuration = tonumber(DelayBox.Text) or 0.5

                if holdDuration < 0.05 then holdDuration = 0.05 end
                if delayDuration < 0 then delayDuration = 0 end

                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                end)

                local elapsed = 0
                while elapsed < holdDuration and isRunning do
                    task.wait(0.05)
                    elapsed = elapsed + 0.05
                end

                if isRunning then
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    end)
                    task.wait(delayDuration)
                end
            else
                StatusLabel.Text = string.format("Status: Cards: %d (<=25). Ignored.", cardCount)
                pcall(function()
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                end)
            end
        end
    end
end)
