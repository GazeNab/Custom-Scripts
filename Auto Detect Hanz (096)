local function getHanzPlayer()
    return Players:FindFirstChild("Hanz") or Players:FindFirstChild("@GeorgeHaminton0") or Players:FindFirstChild("GeorgeHaminton0")
end

task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.5)
        if isRunning then
            local hanz = getHanzPlayer()

            if hanz then
                if not hasTriggeredForCurrentHanz then
                    hasTriggeredForCurrentHanz = true
                    ProgressBox.Text = "Detected Hanz, firing 4 times..."
                    StatusLabel.Text = "Status: Executing 4x loop..."

                    local success, err = pcall(function()
                        local Remotes = ReplicatedStorage:WaitForChild("Remotes")
                        local ChangeVendingItem = Remotes:WaitForChild("ChangeVendingItem")
                        local Dupe = "Supply Crate Card"

                        local buyArgs = {
                            "Buy",
                            {
                                "Items",
                                Dupe,
                                0
                            },
                            hanz
                        }

                        for run = 1, 4 do
                            for i = 1, 150 do
                                ChangeVendingItem:FireServer(unpack(buyArgs))
                            end
                            task.wait(0.2)
                        end
                    end)

                    if success then
                        ProgressBox.Text = "Done (4 times executed)"
                        StatusLabel.Text = "Status: Completed!"
                        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
                    else
                        ProgressBox.Text = "Execution Error"
                        StatusLabel.Text = "Status: Error!"
                        StatusLabel.TextColor3 = THEME.DANGER
                    end
                end
            else
                -- If Hanz leaves, reset the trigger flag so it's ready for next join
                if hasTriggeredForCurrentHanz then
                    hasTriggeredForCurrentHanz = false
                end
                ProgressBox.Text = "waiting"
                StatusLabel.Text = "Status: Waiting for Hanz..."
                StatusLabel.TextColor3 = THEME.TEXT_MUTED
            end
        end
    end
end)
