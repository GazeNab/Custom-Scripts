    if not text or text=="" then return nil end
    local t=text:lower():match("^%s*(.-)%s*$")
    if t=="inf" or t=="infinity" or t=="math.huge" then return math.huge end
    if t=="-inf" or t=="-infinity" or t=="-math.huge" then return -math.huge end
    return tonumber(t)
