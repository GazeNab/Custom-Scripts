                    end
                end
            end
            box.Text=turningOn and "✓" or ""; box.BackgroundColor3=turningOn and SPY_COLOR or Color3.fromRGB(26,26,40)
            s.Color=turningOn and SPY_COLOR or Color3.fromRGB(50,50,70); state.spectating=turningOn
            if turningOn then startSpectating(plr) else stopSpectating() end
            if noTpMode then
                state.checked=turningOn
                persistChecked[plr.Name]=turningOn and true or nil
                local sb=row:FindFirstChild("SelBox")
                if sb then
                    local SEL_C=Color3.fromRGB(60,190,100)
                    sb.Text=turningOn and "✓" or ""; sb.BackgroundColor3=turningOn and SEL_C or Color3.fromRGB(26,26,40)
                    local ss=sb:FindFirstChildOfClass("UIStroke")
                    if ss then ss.Color=turningOn and SEL_C or Color3.fromRGB(50,50,70) end
                end
                leftBar.BackgroundColor3=turningOn and Color3.fromRGB(60,190,100) or Color3.fromRGB(40,40,58)
                updateTpUI()
            end
        end)
        spyBox.Name="SpyBox"

        if isSelf then
            for _,b in ipairs({selBox,spyBox}) do
                b.BackgroundColor3=Color3.fromRGB(20,20,30); b.TextColor3=Color3.fromRGB(40,40,55)
            end
            selS.Color=Color3.fromRGB(30,30,46); spyS.Color=Color3.fromRGB(30,30,46)
        end

        if not isSelf then
            row.MouseEnter:Connect(function() tw(row,{BackgroundColor3=Color3.fromRGB(28,28,42)}) end)
            row.MouseLeave:Connect(function() tw(row,{BackgroundColor3=Color3.fromRGB(22,22,34)}) end)
        end

        playerRows[plr]=row
    end

    updateTpUI()
end

-- ══ SELECT ALL ═════════════════════════════════════════════════════════════
local SEL_COLOR_ALL=Color3.fromRGB(60,190,100)

local function syncSelAllBtn()
    local total,selected=0,0
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LocalPlayer then
            total=total+1
            if playerStates[plr] and playerStates[plr].checked then selected=selected+1 end
        end
    end
    allSelected=(total>0 and selected==total)
    if selected>0 then
        selCountLbl.Text=tostring(selected)
        selCountBadge.Size=selected>=10 and UDim2.new(0,34,0,18) or UDim2.new(0,28,0,18)
        selCountBadge.Visible=true
    else
        selCountBadge.Visible=false
    end
    if allSelected then
        selAllBtn.Text="☐  Deselect All"; selAllBtn.TextColor3=Color3.fromRGB(220,100,100)
        selAllStroke.Color=Color3.fromRGB(140,50,50); tw(selAllBtn,{BackgroundColor3=Color3.fromRGB(44,18,18)})
        selCountBadge.BackgroundColor3=Color3.fromRGB(160,40,40)
    else
        selAllBtn.Text="☑  Select All Players"; selAllBtn.TextColor3=Color3.fromRGB(160,145,230)
        selAllStroke.Color=Color3.fromRGB(70,55,120); tw(selAllBtn,{BackgroundColor3=Color3.fromRGB(30,26,52)})
        selCountBadge.BackgroundColor3=Color3.fromRGB(100,60,180)
    end
end

selAllBtn.MouseButton1Click:Connect(function()
    local shouldSelect=not allSelected
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr==LocalPlayer then continue end
        if not playerStates[plr] then playerStates[plr]={checked=false,spectating=false} end
        playerStates[plr].checked=shouldSelect
        persistChecked[plr.Name]=shouldSelect and true or nil
        if slamActive then slamWasAlive[plr] = nil end
        if klActive then klWasAlive[plr] = nil end
        local row=playerRows[plr]
        if row then
            local sb=row:FindFirstChild("SelBox")
            local lb=row:FindFirstChildWhichIsA("Frame")
            if sb then
                sb.Text=shouldSelect and "✓" or ""
                sb.BackgroundColor3=shouldSelect and SEL_COLOR_ALL or Color3.fromRGB(26,26,40)
                local ss=sb:FindFirstChildOfClass("UIStroke")
                if ss then ss.Color=shouldSelect and SEL_COLOR_ALL or Color3.fromRGB(50,50,70) end
            end
            if lb then lb.BackgroundColor3=shouldSelect and SEL_COLOR_ALL or Color3.fromRGB(40,40,58) end
        end
    end
    allSelected=shouldSelect; selectAllActive=shouldSelect
    if shouldSelect then
        checkOrder={}
        for _,plr in ipairs(Players:GetPlayers()) do
            if plr~=LocalPlayer then table.insert(checkOrder,plr.Name) end
        end
        firstCheckedPlayer=resolveFirstChecked()
    else
        checkOrder={}; firstCheckedPlayer=nil
    end
    syncSelAllBtn(); updateTpUI()
    -- Only auto-start TP loop if KL is not active
    if shouldSelect then
        if not klActive then startTpLoop() end
    else
        stopTpLoop()
        if autoSlapActive then stopAutoSlap() end
    end
end)

-- ══ PLAYER EVENTS — real-time join/leave ═══════════════════════════════════
Players.PlayerAdded:Connect(function(plr)
    playerStates[plr]={checked=persistChecked[plr.Name]==true or selectAllActive,spectating=false}
    refreshPlayerList()
    syncSelAllBtn()
    updateTpUI()
    if (persistChecked[plr.Name] or selectAllActive) and plr~=LocalPlayer then
        if not klActive then startTpLoop() end
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    if spectateTarget==plr then stopSpectating() end
    if firstCheckedPlayer==plr then firstCheckedPlayer=nil end
    for i,n in ipairs(checkOrder) do if n==plr.Name then table.remove(checkOrder,i); break end end
    playerStates[plr]=nil
    slamWasAlive[plr]=nil
    klWasAlive[plr]=nil
    if playerRows[plr] then playerRows[plr]:Destroy(); playerRows[plr]=nil end
    countLbl.Text=tostring(#Players:GetPlayers()).." online"
    syncSelAllBtn(); updateTpUI()
end)

-- ══ AIM RAYCAST — runs on Heartbeat, throttled ═════════════════════════════
local _aimTimer=0
local _aimParams=RaycastParams.new()
RunService.Heartbeat:Connect(function(dt)
    -- ── Aim info update (~20 fps)
    _aimTimer=_aimTimer+dt
    if _aimTimer>=0.05 then
        _aimTimer=0
        local mousePos=UIS:GetMouseLocation()
        local found=nil
        local bestDist=80
        for _,plr in ipairs(Players:GetPlayers()) do
            if plr==LocalPlayer then continue end
            local c=plr.Character
            local hrp=c and c:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end
            local screenPos,onScreen=camera:WorldToViewportPoint(hrp.Position)
            if not onScreen then continue end
            local dx=screenPos.X-mousePos.X
            local dy=screenPos.Y-mousePos.Y
            local d=math.sqrt(dx*dx+dy*dy)
            if d<bestDist then bestDist=d; found=plr end
        end
        if found~=aimTarget then
            aimTarget=found
            if found then
                aimNameLbl.Text=found.DisplayName
                aimNameLbl.TextColor3=Color3.fromRGB(255,220,80)
                mkStroke(aimBox,Color3.fromRGB(160,100,255),1.5)
            else
                aimNameLbl.Text="—"
                aimNameLbl.TextColor3=Color3.fromRGB(160,130,255)
                mkStroke(aimBox,Color3.fromRGB(55,35,110),1.2)
            end
        end
    end

    -- ── Dist pill + alive dot update (10 fps)
    _distTimer=_distTimer+dt
    _dotTimer=_dotTimer+dt
    if _dotTimer>=0.55 then _dotTimer=0; _dotVisible=not _dotVisible end
    if _distTimer>=0.1 then _distTimer=0; updateDistPill() end
end)

