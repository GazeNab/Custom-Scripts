local function startKL()
    if klActive then return end
    if getEquippedTool() == nil then
        -- Flash pill red to hint: no tool equipped
        tw(klToolPill, {BackgroundColor3 = Color3.fromRGB(60,14,14)})
        task.delay(0.4, function() tw(klToolPill, {BackgroundColor3 = Color3.fromRGB(18,12,24)}) end)
        return
    end
    klActive = true
    table.clear(klWasAlive)

    -- Seed initial alive states so we don't fire on first frame
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            klWasAlive[plr] = isPlayerAlive(plr)
        end
    end

    klBtn.Text = "🎯  KL  [ ON ]"
    klBtn.TextColor3 = Color3.fromRGB(255,180,255)
    tw(klBtn, {BackgroundColor3 = Color3.fromRGB(50,12,60)})
    klBtnStroke.Color = Color3.fromRGB(200,60,240)
    tw(klDot, {BackgroundColor3 = Color3.fromRGB(240,100,255)})

    klConn = RunService.Heartbeat:Connect(function()
        if not klActive then return end

        -- Keep tool-name pill updated every frame
        local heldTool = getEquippedTool()
        if heldTool then
            klToolNameLbl.Text = heldTool.Name
            klToolNameLbl.TextColor3 = Color3.fromRGB(210,160,255)
            klToolIcon.Text = "⚔️"
        else
            klToolNameLbl.Text = "No tool equipped"
            klToolNameLbl.TextColor3 = Color3.fromRGB(100,70,130)
            klToolIcon.Text = "🔧"
        end

        -- Pause firing if tool was unequipped, but stay ON so it resumes when re-equipped
        if not heldTool then return end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end

            local state = playerStates[plr]
            if not (state and state.checked) then
                klWasAlive[plr] = nil   -- reset seed; will re-seed when checked again
                continue
            end

            local nowAlive = isPlayerAlive(plr)
            local wasAlive = klWasAlive[plr]

            if wasAlive == nil then
                -- Freshly checked: seed without firing
                klWasAlive[plr] = nowAlive
            elseif nowAlive and not wasAlive then
                -- Just respawned alive → fire immediately
                klWasAlive[plr] = true
                doKLUse(plr)
            elseif nowAlive and wasAlive then
                -- Continuously alive → fire every frame (maximum pressure)
                doKLUse(plr)
            else
                -- Dead or no character
                klWasAlive[plr] = false
            end
        end
    end)
end

