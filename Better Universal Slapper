-- ── KL LOGIC ───────────────────────────────────────────────────────────────

local function getEquippedTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Tool")
end

--[[
    doKLUse: dispatches the correct attack for each known tool by name.
    Each tool uses a different remote name and argument format discovered
    by inspecting the tool's descendant tree.

    Known tools and their mechanisms:
      SlapHand      — RemoteEvent "Event"      :FireServer("slash", tgtChar, Vector3)
      FireSlap      — RemoteEvent "Event"      :FireServer("slash", tgtChar, Vector3)
      GoldenSlap    — RemoteEvent "Event"      :FireServer("slash", tgtChar, Vector3)
      GodSlap       — RemoteEvent "Event"      :FireServer("slash", tgtChar, Vector3)
      FreezeGun     — RemoteEvent "FireEvent"  :FireServer(tgtChar)
      BodySwap      — RemoteEvent "SwapWith"   :FireServer(tgtChar)
      GoldCarpet    — RemoteFunction "ServerControl" (unknown args; best-effort)
      BanHammer     — NO remote; touch-based. We move the Handle onto the target.
      Everything else — generic fallback: try RemoteEvent/RemoteFunction with common arg patterns
]]
local function doKLUse(plr)
    local tool = getEquippedTool()
    if not tool then return end
    local tgtChar = plr.Character
    if not tgtChar then return end
    local tgtHRP = tgtChar:FindFirstChild("HumanoidRootPart")
    local tgtPos  = tgtHRP and tgtHRP.Position or Vector3.zero
    local name = tool.Name

    -- ── Slap-family tools (SlapHand, FireSlap, GoldenSlap, GodSlap)
    -- All share the same remote name "Event" and the same FireServer signature.
    if name == "SlapHand" or name == "FireSlap" or name == "GoldenSlap" or name == "GodSlap" then
        local remote = tool:FindFirstChild("Event")
        if remote and remote:IsA("RemoteEvent") then
            pcall(function() remote:FireServer("slash", tgtChar, Vector3.new(0, 80, 0)) end)
        end

    -- ── FreezeGun — RemoteEvent "FireEvent", just pass the target character
    elseif name == "FreezeGun" then
        local remote = tool:FindFirstChild("FireEvent")
        if remote and remote:IsA("RemoteEvent") then
            pcall(function() remote:FireServer(tgtChar) end)
        end

    -- ── BodySwap — RemoteEvent "SwapWith", pass the target character
    elseif name == "BodySwap" then
        local remote = tool:FindFirstChild("SwapWith")
        if remote and remote:IsA("RemoteEvent") then
            pcall(function() remote:FireServer(tgtChar) end)
        end

    -- ── GoldCarpet — RemoteFunction "ServerControl"
    -- Exact args unknown; try the target character and player object
    elseif name == "GoldCarpet" then
        local rf = tool:FindFirstChild("ServerControl")
        if rf and rf:IsA("RemoteFunction") then
            pcall(function() rf:InvokeServer(tgtChar) end)
            pcall(function() rf:InvokeServer(plr) end)
        end

    elseif name == "BanHammer" then
        -- Drop the tool into workspace so the local character doesn't move with it.
        -- Only the Handle gets repositioned; other players never see a teleport.
        tool.Parent = workspace
        local handle = tool:FindFirstChild("Handle")
        if handle and tgtHRP then
            pcall(function()
                handle.CFrame = tgtHRP.CFrame
                handle.AssemblyLinearVelocity = Vector3.zero
                handle.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        -- Re-parent back to backpack so KL can reuse it next frame
        task.delay(0.08, function()
            if tool and tool.Parent ~= nil then
                tool.Parent = LocalPlayer.Backpack
            end
        end)

    -- ── Generic fallback for any other tool not listed above.
    -- Tries the most common RemoteEvent/RemoteFunction argument patterns.
    else
        for _, child in ipairs(tool:GetDescendants()) do
            if child:IsA("RemoteEvent") then
                pcall(function() child:FireServer(tgtChar) end)
                pcall(function() child:FireServer("slash", tgtChar, Vector3.new(0, 80, 0)) end)
                pcall(function() child:FireServer(tgtHRP, tgtPos) end)
                pcall(function() child:FireServer(tgtChar, tgtPos) end)
                pcall(function() child:FireServer(plr) end)
            elseif child:IsA("RemoteFunction") then
                pcall(function() child:InvokeServer(tgtChar) end)
                pcall(function() child:InvokeServer(plr) end)
            end
        end
        pcall(function() tool:Activate() end)
    end
end

local function stopKL()
