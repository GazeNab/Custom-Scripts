-- ══ FILTER ═════════════════════════════════════════════════════════════════
local function playerMatchesQuery(plr, query)
    if query=="" then return true end
    local q=query:gsub("^@","")
    return plr.DisplayName:lower():find(q,1,true)~=nil
        or plr.Name:lower():find(q,1,true)~=nil
end

local function filterPlayerList()
    for plr,row in pairs(playerRows) do
        if row and row.Parent then
            row.Visible=playerMatchesQuery(plr,searchQuery)
        end
    end
end

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    searchQuery=searchBox.Text:lower(); filterPlayerList()
end)

