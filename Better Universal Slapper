local function doTeleportStep()
    local checked=getCheckedPlayers(); if #checked==0 then return end
    local myChar=LocalPlayer.Character
    local myHRP=myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
    if not myHRP then return end
    local myPos=myHRP.Position; local lookDir=myHRP.CFrame.LookVector
    local flatLook=Vector3.new(lookDir.X,0,lookDir.Z)
    if flatLook.Magnitude<0.01 then flatLook=Vector3.new(0,0,-1) end
    flatLook=flatLook.Unit
    local basePos=myPos+flatLook*tpDistance
    local destPos=Vector3.new(basePos.X,myPos.Y,basePos.Z)
    local lookAt=destPos+flatLook
    for _,tgt in ipairs(checked) do
        local tgtChar=tgt.Character
        local tgtHRP=tgtChar and (tgtChar:FindFirstChild("HumanoidRootPart") or tgtChar:FindFirstChild("Torso"))
        if not tgtHRP then continue end
        pcall(function()
            tgtHRP.CFrame=CFrame.new(destPos,lookAt)
            tgtHRP.AssemblyLinearVelocity=Vector3.zero
            tgtHRP.AssemblyAngularVelocity=Vector3.zero
        end)
    end
end

