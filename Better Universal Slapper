local function isPlayerAlive(plr)
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    return hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead
end

local function doSlamClick()
    local character = LocalPlayer.Character
    if not character then return end
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end
end

local function stopSlam()
    slamActive = false
    if slamConn then slamConn:Disconnect(); slamConn = nil end
    table.clear(slamWasAlive)
    slamBtn.Text = "⚡  SLAM  [ OFF ]"
    slamBtn.TextColor3 = Color3.fromRGB(70,130,190)
    tw(slamBtn, {BackgroundColor3 = Color3.fromRGB(14,28,42)})
    slamBtnStroke.Color = Color3.fromRGB(30,80,130)
    tw(slamDot, {BackgroundColor3 = Color3.fromRGB(50,80,110)})
end

local function startSlam()
    if slamActive then return end
    slamActive = true
    table.clear(slamWasAlive)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            slamWasAlive[plr] = isPlayerAlive(plr)
        end
    end
    slamBtn.Text = "⚡  SLAM  [ ON ]"
    slamBtn.TextColor3 = Color3.fromRGB(255,255,100)
    tw(slamBtn, {BackgroundColor3 = Color3.fromRGB(40,35,10)})
    slamBtnStroke.Color = Color3.fromRGB(200,180,30)
    tw(slamDot, {BackgroundColor3 = Color3.fromRGB(255,230,40)})
    slamConn = RunService.Heartbeat:Connect(function()
        if not slamActive then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local state = playerStates[plr]
            if not (state and state.checked) then
                slamWasAlive[plr] = nil
                continue
            end
            local nowAlive = isPlayerAlive(plr)
            local wasAlive = slamWasAlive[plr]
            if wasAlive == nil then
                slamWasAlive[plr] = nowAlive
            elseif nowAlive and not wasAlive then
                slamWasAlive[plr] = true
                doSlamClick()
            elseif nowAlive and wasAlive then
                doSlamClick()
            else
                slamWasAlive[plr] = false
            end
        end
    end)
end

slamBtn.MouseButton1Click:Connect(function()
    if slamActive then stopSlam() else startSlam() end
end)

