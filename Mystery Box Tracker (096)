local function getSupplyCrateCardCount()
    local count = 0
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local backpackRoot = playerGui and playerGui:FindFirstChild("Main") 
        and playerGui.Main:FindFirstChild("Backpack") 
        and playerGui.Main.Backpack:FindFirstChild("Backpack")

    if backpackRoot then
        local function scanGrid(folderObject)
            if not folderObject then return end
            for _, slot in ipairs(folderObject:GetChildren()) do
                if tonumber(slot.Name) and slot:IsA("ImageButton") then
                    local itemName = slot:GetAttribute("Item")
                    if itemName == "Supply Crate Card" then
                        local countText = "1"
                        local countObj = slot:FindFirstChild("Count")
                        if countObj and countObj:IsA("TextLabel") and countObj.Visible then
                            countText = countObj.Text
                        end
                        count = count + (tonumber(countText) or 1)
                    end
                end
            end
        end

        scanGrid(backpackRoot:FindFirstChild("Frame"))
        scanGrid(backpackRoot:FindFirstChild("Explorers"))
    end
    return count
end

-- Detection Loop
task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.4)
        local currentCards = getSupplyCrateCardCount()

        if lastKnownCardCount == -1 then
            lastKnownCardCount = currentCards
            if currentCards > 0 then
                totalEarnedAttempts = totalEarnedAttempts + math.floor(currentCards / 25)
            end
        else
            -- Check if cards increased (gained/bought new cards)
            if currentCards > lastKnownCardCount then
                local diff = currentCards - lastKnownCardCount
                local newAttempts = math.floor(diff / 25)
                if newAttempts > 0 then
                    totalEarnedAttempts = totalEarnedAttempts + newAttempts
                end
            -- Check if cards decreased (spent cards)
            elseif currentCards < lastKnownCardCount then
                local diff = lastKnownCardCount - currentCards
                cardsUsed = cardsUsed + diff
                
                -- Calculate how many attempts worth of cards were spent
                local spentAttempts = math.floor(diff / 25)
                if spentAttempts > 0 then
                    attemptsUsed = attemptsUsed + spentAttempts
                end
            end
            lastKnownCardCount = currentCards
        end

        local remainingAttempts = math.max(0, totalEarnedAttempts - attemptsUsed)

        AttemptsBox.Text = string.format("Total Attempts: %d", totalEarnedAttempts)
        AttemptsUsedBox.Text = string.format("Attempts Used: %d", attemptsUsed)
        UsedBox.Text = string.format("Cards Used: %d", cardsUsed)
        StatusLabel.Text = string.format("Cards: %d | Left: %d", currentCards, remainingAttempts)
    end
end)
