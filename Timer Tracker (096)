detailLabel.TextSize = 11
detailLabel.TextXAlignment = Enum.TextXAlignment.Left
detailLabel.Parent = contentFrame

-- Helper Function to Create Setting Rows
local function createSettingRow(posY, labelText, defaultVal, textColor)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 24)
    container.Position = UDim2.new(0, 0, 0, posY)
    container.BackgroundTransparency = 1
    container.Parent = contentFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 110, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamMedium
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 90, 1, 0)
    box.Position = UDim2.new(1, -90, 0, 0)
    box.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    box.Font = Enum.Font.GothamBold
    box.Text = defaultVal
    box.TextColor3 = textColor
    box.TextSize = 12
    box.Parent = container

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = box

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 75)
    stroke.Thickness = 1
    stroke.Parent = box

    return box
end

-- 5. Build All 3 Control Textboxes
local dayMultiplierBox   = createSettingRow(78,  "Day Controller:",   "30", Color3.fromRGB(255, 220, 50))
local nightMultiplierBox = createSettingRow(106, "Night Controller:", "30", Color3.fromRGB(100, 150, 255))
local speedBox           = createSettingRow(134, "Speed Controller:", "1",  Color3.fromRGB(0, 255, 128))

-- 6. Countdown Engine combining Day, Night, and Speed Modifiers
RunService.RenderStepped:Connect(function()
    if not screenGui.Parent then return end
    
    local clockTime = Lighting.ClockTime
    
    -- Format ClockTime into 12-Hour MM:SS AM/PM
    local totalMinutes = clockTime * 60
    local hour24 = math.floor(totalMinutes / 60)
    local minute = math.floor(totalMinutes % 60)
    local ampm = hour24 >= 12 and "PM" or "AM"
    local hour12 = hour24 % 12
    if hour12 == 0 then hour12 = 12 end
    
    detailLabel.Text = string.format("ClockTime: %d:%02d %s", hour12, minute, ampm)
    
    local isDay = (clockTime >= 6 and clockTime < 18)
    stateLabel.Text = "State: " .. (isDay and "☀️ DAY" or "🌙 NIGHT")
    stateLabel.TextColor3 = isDay and Color3.fromRGB(255, 220, 50) or Color3.fromRGB(100, 150, 255)
    
    local targetClock = isDay and 18 or 6
    local hoursRemaining = targetClock - clockTime
    if hoursRemaining < 0 then
        hoursRemaining = hoursRemaining + 24
    end
    
    -- Base phase multiplier
    local baseMultiplier = isDay and (tonumber(dayMultiplierBox.Text) or 30) or (tonumber(nightMultiplierBox.Text) or 30)
    -- Overall speed modifier scale
    local speedScale = tonumber(speedBox.Text) or 1
    
    local totalSecs = math.max(0, math.floor(hoursRemaining * baseMultiplier * speedScale))
    local mins = math.floor(totalSecs / 60)
    local secs = totalSecs % 60
    
    countdownLabel.Text = string.format("To %s: %d:%02d", (isDay and "Night" or "Day"), mins, secs)
end)
