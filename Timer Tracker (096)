--[========================================================================]--
-- Script Name: UniqueDayNightTrackerGui
-- Description: Standalone GUI with Day Controller, Night Controller, AND 
--              Speed Controller textboxes for full cycle calibration.
--[========================================================================]--

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 1. Unique Window Isolation & Cleanup Check
local UNIQUE_NAME = "UniqueDayNightTrackerGui"
if PlayerGui:FindFirstChild(UNIQUE_NAME) then
    PlayerGui[UNIQUE_NAME]:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = UNIQUE_NAME
screenGui.ResetOnSpawn = false
screenGui.Parent = PlayerGui

