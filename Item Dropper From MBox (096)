-- Real-time Backpack Scanner & Teleport Drop Loop
task.spawn(function()
    while true do
        task.wait(0.5)
        if isRunning and not isExecuting then
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            local backpackRoot = playerGui and playerGui:FindFirstChild("Main") 
                and playerGui.Main:FindFirstChild("Backpack") 
                and playerGui.Main.Backpack:FindFirstChild("Backpack")

            if backpackRoot then
                local foundItems = {}

                local function parseGrid(folderObject)
                    if not folderObject then return end
                    for _, slot in ipairs(folderObject:GetChildren()) do
                        if tonumber(slot.Name) and slot:IsA("ImageButton") then
                            local itemName = slot:GetAttribute("Item")
                            if itemName and itemName ~= "Supply Crate Card" then
                                local countText = "1"
                                local countObj = slot:FindFirstChild("Count")
                                if countObj and countObj:IsA("TextLabel") and countObj.Visible then
                                    countText = countObj.Text
                                end
                                local countVal = tonumber(countText) or 1
                                table.insert(foundItems, {Name = tostring(itemName), Count = countVal})
                            end
                        end
                    end
                end

                parseGrid(backpackRoot:FindFirstChild("Frame"))
                parseGrid(backpackRoot:FindFirstChild("Explorers"))

                if #foundItems > 0 then
                    local targetPos = parseCoords(TargetCoordsBox.Text)
                    if targetPos then
                        isExecuting = true
                        StatusLabel.Text = "Status: Items detected! Executing routine..."

                        local char = LocalPlayer.Character
                        local rootPart = char and char:FindFirstChild("HumanoidRootPart")

                        if rootPart then
                            originalCFrame = rootPart.CFrame

                            -- Teleport instantly to target coordinates
                            rootPart.CFrame = CFrame.new(targetPos)
                            task.wait(0.3)

                            -- Drop all collected items except Supply Crate Card
                            for _, itemData in ipairs(foundItems) do
                                for i = 1, itemData.Count do
                                    pcall(function()
                                        local args = {
                                            "Drop",
                                            itemData.Name
                                        }
                                        backpackRemote:FireServer(unpack(args))
                                    end)
                                    task.wait(0.08)
                                end
                            end

                            task.wait(0.3)
                            -- Teleport back instantly to original position
                            if originalCFrame then
                                rootPart.CFrame = originalCFrame
                                originalCFrame = nil
                            end
                        end

                        StatusLabel.Text = "Status: Monitoring backpack..."
                        isExecuting = false
                    else
                        StatusLabel.Text = "Status: Error - Invalid target coordinates format!"
                    end
                end
            end
        end
    end
end)
