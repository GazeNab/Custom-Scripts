            return Color3.fromRGB(0, 255, 100)
        elseif seed == 1 then
            return Color3.fromRGB(0, 120, 50)
        else
            return Color3.fromRGB(5, 15, 10)
        end
    end,

    -- Pattern 182: Pulsing Crystal Core
    function(gx, gz, width, length)
        local cx, cz = (width - 1) / 2, (length - 1) / 2
        local manhattan = math.abs(gx - cx) + math.abs(gz - cz)
        local pulse = (math.sin(tick() * 4) + 1) * 2.5
        if manhattan <= pulse then
            return Color3.fromRGB(180, 240, 255)
        elseif manhattan <= pulse + 1.5 then
            return Color3.fromRGB(80, 100, 200)
        else
            return Color3.fromRGB(10, 10, 25)
        end
    end,

    -- Pattern 183: Orbiting Twin Pulsars
    function(gx, gz, width, length)
        local cx, cz = (width - 1) / 2, (length - 1) / 2
        local t = tick() * 3
        local p1x, p1z = cx + math.cos(t) * 3, cz + math.sin(t) * 3
        local p2x, p2z = cx + math.cos(t + math.pi) * 3, cz + math.sin(t + math.pi) * 3
        
        local d1 = math.sqrt((gx - p1x)^2 + (gz - p1z)^2)
        local d2 = math.sqrt((gx - p2x)^2 + (gz - p2z)^2)
        
        if d1 < 1.2 then
            return Color3.fromRGB(255, 200, 50)
        elseif d2 < 1.2 then
            return Color3.fromRGB(50, 200, 255)
        else
            return Color3.fromRGB(10, 10, 20)
        end
    end,

    -- Pattern 184: Rotating Radar Scanner
    function(gx, gz, width, length)
        local cx, cz = (width - 1) / 2, (length - 1) / 2
        local angle = math.atan2(gz - cz, gx - cx)
        local sweep = (tick() * 3) % (math.pi * 2) - math.pi
        local diff = (angle - sweep) % (math.pi * 2)
        if diff < 0.8 then
            local intensity = 1 - (diff / 0.8)
            return Color3.fromRGB(0, math.floor(intensity * 255), math.floor(intensity * 80))
        else
            return Color3.fromRGB(0, 20, 0)
        end
    end,

    -- Pattern 185: Electric Spark Lattice
    function(gx, gz, width, length)
        local noise = (math.sin(gx * 12.9898 + gz * 78.233 + tick() * 10) * 43758.5453) % 1
        if noise > 0.82 then
            return Color3.fromRGB(200, 240, 255)
        elseif noise > 0.65 then
            return Color3.fromRGB(0, 100, 255)
        else
            return Color3.fromRGB(10, 10, 30)
        end
    end,

    -- Pattern 186: Shifting Diagonal Chevron
    function(gx, gz, width, length)
        local offset = math.floor(tick() * 5)
        local chev = (gx + gz + offset) % 6
        if chev == 0 or chev == 1 then
            return Color3.fromRGB(255, 0, 120)
        elseif chev == 2 then
            return Color3.fromRGB(100, 0, 80)
        else
            return Color3.fromRGB(15, 5, 20)
        end
    end,

    -- Pattern 187: Solar Prominence Wave
    function(gx, gz, width, length)
        local wave = math.sin(gx * 0.5 + tick() * 3) * 2 + (length / 2)
        local dist = math.abs(gz - wave)
        if dist < 1.0 then
            return Color3.fromRGB(255, 220, 50)
        elseif dist < 2.5 then
            return Color3.fromRGB(255, 80, 0)
        else
            return Color3.fromRGB(30, 5, 0)
        end
    end,

    -- Pattern 188: Hypnotic Tunnel Ring
    function(gx, gz, width, length)
        local cx, cz = (width - 1) / 2, (length - 1) / 2
        local dist = math.sqrt((gx - cx)^2 + (gz - cz)^2)
        local ring = (dist - tick() * 4) % 3
        if ring < 1.0 then
            return Color3.fromRGB(0, 255, 200)
        else
            return Color3.fromRGB(20, 10, 40)
        end
    end,

    -- Pattern 189: Thermal Imaging Flame
    function(gx, gz, width, length)
        local t = tick() * 3
        local noise = math.sin(gx * 0.8 + t) + math.cos(gz * 0.8 - t)
        local heat = math.clamp((noise + 2) / 4, 0, 1)
        if heat > 0.75 then
            return Color3.fromRGB(255, 255, 200)
        elseif heat > 0.5 then
            return Color3.fromRGB(255, 120, 0)
        elseif heat > 0.25 then
            return Color3.fromRGB(180, 0, 100)
        else
            return Color3.fromRGB(20, 0, 40)
        end
    end,

    -- Pattern 190: Digital Beacon Radar
    function(gx, gz, width, length)
        local cx, cz = (width - 1) / 2, (length - 1) / 2
        local dist = math.sqrt((gx - cx)^2 + (gz - cz)^2)
        local pulse = (tick() * 5) % (width * 0.6)
        if math.abs(dist - pulse) < 0.8 then
            return Color3.fromRGB(255, 50, 50)
        else
            return Color3.fromRGB(15, 15, 20)
        end
    end,

    -- Pattern 191: Kinetic Sound Waveform
    function(gx, gz, width, length)
        local amplitude = math.sin(gx * 0.6 + tick() * 6) * (length * 0.35)
        local mid = (length - 1) / 2
        if math.abs(gz - (mid + amplitude)) < 0.8 then
            return Color3.fromRGB(50, 255, 150)
        else
            return Color3.fromRGB(10, 25, 15)
        end
    end,

    -- Pattern 192: Cybernetic Hex Matrix
    function(gx, gz, width, length)
        local val = (gx * 2 + gz * 3 + math.floor(tick() * 4)) % 5
        if val == 0 then
            return Color3.fromRGB(0, 200, 255)
        elseif val == 1 then
            return Color3.fromRGB(0, 80, 160)
        else
            return Color3.fromRGB(5, 15, 30)
        end
    end,

    -- Pattern 193: Expanding Diamond Shockwave
    function(gx, gz, width, length)
        local cx, cz = (width - 1) / 2, (length - 1) / 2
        local diamondDist = math.abs(gx - cx) + math.abs(gz - cz)
        local wave = (tick() * 6) % (width + length)
        if math.abs(diamondDist - wave) < 1.0 then
            return Color3.fromRGB(255, 230, 100)
        else
            return Color3.fromRGB(20, 10, 5)
        end
    end,

    -- Pattern 194: Deep Void Event Horizon
    function(gx, gz, width, length)
        local cx, cz = (width - 1) / 2, (length - 1) / 2
        local dist = math.sqrt((gx - cx)^2 + (gz - cz)^2)
        if dist < 1.8 then
            return Color3.fromRGB(0, 0, 0)
        elseif dist < 3.2 then
            local glow = (math.sin(tick() * 5) + 1) * 0.5
            return Color3.fromRGB(math.floor(glow * 255), 100, 255)
        else
            return Color3.fromRGB(15, 5, 25)
        end
    end,

    -- Pattern 195: Alternating Strobe Grid
    function(gx, gz, width, length)
        local step = math.floor(tick() * 6) % 2
        local cell = (gx + gz) % 2
        if cell == step then
            return Color3.fromRGB(255, 255, 255)
        else
            return Color3.fromRGB(20, 20, 20)
        end
    end,

    -- Pattern 196: Subatomic Orbit Cloud
    function(gx, gz, width, length)
        local cx, cz = (width - 1) / 2, (length - 1) / 2
        local t = tick() * 4
        local x = cx + math.cos(t * 1.3) * 3
        local z = cz + math.sin(t * 0.9) * 3
        local dist = math.sqrt((gx - x)^2 + (gz - z)^2)
        if dist < 1.2 then
            return Color3.fromRGB(255, 0, 200)
        else
            return Color3.fromRGB(10, 5, 20)
        end
    end,

    -- Pattern 197: Shifting Color Cascade
    function(gx, gz, width, length)
        local hue = ((gx * 0.1 + gz * 0.1) + tick() * 0.3) % 1
        return Color3.fromHSV(hue, 0.85, 0.9)
    end,

    -- Pattern 198: Holographic Target Crosshair
    function(gx, gz, width, length)
        local cx, cz = (width - 1) / 2, (length - 1) / 2
        local isCenter = math.abs(gx - cx) < 0.6 or math.abs(gz - cz) < 0.6
        local ring = math.abs(math.sqrt((gx - cx)^2 + (gz - cz)^2) - 3) < 0.6
        if isCenter and ring then
            return Color3.fromRGB(255, 255, 255)
        elseif isCenter or ring then
            return Color3.fromRGB(0, 255, 100)
        else
            return Color3.fromRGB(5, 20, 10)
        end
    end,

    -- Pattern 199: Bioluminescent Fluid Flow
    function(gx, gz, width, length)
        local t = tick() * 2
        local flow = math.sin(gx * 0.4 + gz * 0.3 + t) + math.cos(gz * 0.5 - t)
        local intensity = math.clamp((flow + 2) / 4, 0, 1)
        return Color3.fromRGB(0, math.floor(intensity * 230), math.floor(intensity * 255))
    end,

    -- Pattern 200: Particle Beam Core
    function(gx, gz, width, length)
        local cx = (width - 1) / 2
        local dist = math.abs(gx - cx)
        local pulse = math.sin(gz * 0.8 - tick() * 8)
        if dist < 0.8 then
            return Color3.fromRGB(255, 255, 200)
        elseif dist < 2.0 and pulse > 0 then
            return Color3.fromRGB(255, 100, 0)
        else
            return Color3.fromRGB(20, 10, 10)
        end
    end,
}

local TOTAL_PATTERNS = #animationPatterns

-- ============================================
-- GET PATTERN COLOR
-- ============================================
local function getPatternColor(patternIndex, gx, gz, width, length)
	if patternIndex < 1 or patternIndex > TOTAL_PATTERNS then
		return Color3.fromRGB(128, 128, 128)
	end
	return animationPatterns[patternIndex](gx, gz, width, length)
end

-- ============================================
-- OPTIMIZED SNAPSHOT WITH CACHING
-- ============================================
local function snapshotExisting(forceRefresh)
	local currentTime = tick()
	
	-- Use cache if recent and not forced refresh
	if not forceRefresh and (currentTime - lastSnapshotTime) < SNAPSHOT_CACHE_TIME then
		return cachedExisting
	end
	
	local existing = {}
	local placedBuildings = workspace:FindFirstChild("PlacedBuildings")
	if not placedBuildings then 
		cachedExisting = existing
		lastSnapshotTime = currentTime
		return existing 
	end
	
	for _, model in pairs(placedBuildings:GetChildren()) do
		if model:IsA("Model") then
			local owner = model:FindFirstChild("PlayerOwner")
			if owner and owner.Value == player then
				local pos = model:GetPivot().Position
				local key = math.round(pos.X * 10) .. "_" .. math.round(pos.Y * 10) .. "_" .. math.round(pos.Z * 10)
				existing[key] = true
			end
		end
	end
	
	cachedExisting = existing
	lastSnapshotTime = currentTime
	return existing
end

-- ============================================
-- PAINT FLOOR TILES (using platformKeySet which stores grid info)
-- ============================================
local function paintFloorTiles(patternIndex)
	local placedBuildings = workspace:FindFirstChild("PlacedBuildings")
	if not placedBuildings then return end

	local width  = PLATFORM_WIDTH
	local length = PLATFORM_LENGTH

	for _, model in pairs(placedBuildings:GetChildren()) do
		if model.Name == ITEM_NAME then
			local owner = model:FindFirstChild("PlayerOwner")
			if owner and owner.Value == player then
				local pos = model:GetPivot().Position
				local key = math.round(pos.X * 10) .. "_" .. math.round(pos.Y * 10) .. "_" .. math.round(pos.Z * 10)
				local gridInfo = platformKeySet[key]
				if gridInfo then
					local color = getPatternColor(patternIndex, gridInfo.gx, gridInfo.gz, width, length)
					pcall(function()
						paintRemote:FireServer(model, color)
					end)
				end
			end
		end
	end
end

-- ============================================
-- DUAL-TIMER SYNC HANDLER (Only used when manual mode is OFF)
-- ============================================
local function onAnimTimerFired(whichTimer)
	if not isAnimEnabled or isManualAnimMode then return end

	task.spawn(function()
		paintFloorTiles(currentPattern)
	end)

	if whichTimer == "V3" then
		v3Fired = true
	elseif whichTimer == "V4" then
		v4Fired = true
	end

	if v3Fired and v4Fired then
		v3Fired = false
		v4Fired = false
		currentPattern = (currentPattern % TOTAL_PATTERNS) + 1
	end
end

