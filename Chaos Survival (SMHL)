		end
	end,

	-- Pattern 24: 3x3 Large Checkers
	function(gx, gz, width, length)
		local bx = math.floor(gx / 3)
		local bz = math.floor(gz / 3)
		return ((bx + bz) % 2 == 0) and Color3.fromRGB(150, 80, 220) or Color3.fromRGB(40, 20, 60)
	end,

	-- Pattern 25: Perimeter Frame Sequence
	function(gx, gz, width, length)
		local depth = math.min(gx, gz, (width - 1) - gx, (length - 1) - gz)
		local frameColors = {
