-- BUILD PATTERNS TABLE (Like animationPatterns)
-- ============================================
local buildPatterns = {
	-- BUILD 1: PLATFORM FLOOR
	function(width, length, baseX, baseY, baseZ, tileSize)
		local tiles = {}
		local gridInfo = {}
		
		local function getSpiralPositions(w, l)
			local positions = {}
			local visited = {}
			for i = 0, w - 1 do
				visited[i] = {}
				for j = 0, l - 1 do
					visited[i][j] = false
				end
			end

			local centerX = math.floor((w - 1) / 2)
			local centerZ = math.floor((l - 1) / 2)
			local x, z = centerX, centerZ

			table.insert(positions, {x, z})
			visited[x][z] = true

			local directions = {{1, 0}, {0, 1}, {-1, 0}, {0, -1}}
			local dir = 1
			local steps = 1

			while #positions < w * l do
				for _ = 1, 2 do
					for _ = 1, steps do
						x = x + directions[dir][1]
						z = z + directions[dir][2]
						if x >= 0 and x < w and z >= 0 and z < l and not visited[x][z] then
							table.insert(positions, {x, z})
							visited[x][z] = true
						end
					end
					dir = dir % 4 + 1
				end
				steps = steps + 1
			end

			return positions
		end

		local spiralOrder = getSpiralPositions(width, length)
		for _, coord in ipairs(spiralOrder) do
			local gx = coord[1]
			local gz = coord[2]
			local offsetX = (gx - (width - 1) / 2) * tileSize
			local offsetZ = (gz - (length - 1) / 2) * tileSize
			local cf = CFrame.new(baseX + offsetX, baseY, baseZ + offsetZ)
			table.insert(tiles, { blockType = ITEM_NAME, cf = cf })
			
			local key = math.round(cf.Position.X * 10) .. "_" .. math.round(cf.Position.Y * 10) .. "_" .. math.round(cf.Position.Z * 10)
			gridInfo[key] = {gx = gx, gz = gz}
		end
		
		return tiles, gridInfo, true -- returns: tiles, gridInfo, isPlatform
	end,

	-- BUILD 2: WALLS (1ST WALLS - Staircase/Outward)
	function(width, length, baseX, baseY, baseZ, tileSize, wallHeight)
		local tiles = {}
		
		for h = 1, wallHeight do
			local wallY = baseY + h * tileSize
			local push = (h - 1) * tileSize

			local halfW = ((width - 1) / 2) * tileSize
			local halfL = ((length - 1) / 2) * tileSize

			-- Front wall (Z+)
			for gx = 0, width - 1 do
				local offsetX = (gx - (width - 1) / 2) * tileSize
				local offsetZ = halfL + push
				table.insert(tiles, {
					blockType = ITEM_NAME,
					cf = CFrame.new(baseX + offsetX, wallY, baseZ + offsetZ)
				})
			end

			-- Back wall (Z-)
			for gx = 0, width - 1 do
				local offsetX = (gx - (width - 1) / 2) * tileSize
				local offsetZ = -halfL - push
				table.insert(tiles, {
					blockType = ITEM_NAME,
					cf = CFrame.new(baseX + offsetX, wallY, baseZ + offsetZ)
				})
			end

			-- Right wall (X+)
			for gz = 0, length - 1 do
				local offsetX = halfW + push
				local offsetZ = (gz - (length - 1) / 2) * tileSize
				table.insert(tiles, {
					blockType = ITEM_NAME,
					cf = CFrame.new(baseX + offsetX, wallY, baseZ + offsetZ)
				})
			end

			-- Left wall (X-)
			for gz = 0, length - 1 do
				local offsetX = -halfW - push
				local offsetZ = (gz - (length - 1) / 2) * tileSize
				table.insert(tiles, {
					blockType = ITEM_NAME,
					cf = CFrame.new(baseX + offsetX, wallY, baseZ + offsetZ)
				})
			end

			-- Corner gap fills
			for step = 1, push / tileSize do
				local cornerPush = step * tileSize
				local corners = {
					{halfW + cornerPush,  halfL + push},
					{halfW + push,        halfL + cornerPush},
					{-halfW - cornerPush, halfL + push},
					{-halfW - push,       halfL + cornerPush},
					{halfW + cornerPush,  -halfL - push},
					{halfW + push,        -halfL - cornerPush},
					{-halfW - cornerPush, -halfL - push},
					{-halfW - push,       -halfL - cornerPush},
				}
				for _, corner in ipairs(corners) do
					table.insert(tiles, {
						blockType = ITEM_NAME,
						cf = CFrame.new(baseX + corner[1], wallY, baseZ + corner[2])
					})
				end
			end
		end
		
		return tiles, nil, false -- returns: tiles, gridInfo, isPlatform
	end,

	-- BUILD 3: WALLS (2ND WALLS - Simple Stacking/Layered)
	function(width, length, baseX, baseY, baseZ, tileSize, wallHeight)
		local tiles = {}
		
		local halfW = ((width - 1) / 2) * tileSize
		local halfL = ((length - 1) / 2) * tileSize

		for h = 1, wallHeight do
			local wallY = baseY + h * tileSize

			-- Front wall (Z+) - stacks directly above
			for gx = 0, width - 1 do
				local offsetX = (gx - (width - 1) / 2) * tileSize
				local offsetZ = halfL
				table.insert(tiles, {
					blockType = ITEM_NAME,
					cf = CFrame.new(baseX + offsetX, wallY, baseZ + offsetZ)
				})
			end

			-- Back wall (Z-) - stacks directly above
			for gx = 0, width - 1 do
				local offsetX = (gx - (width - 1) / 2) * tileSize
				local offsetZ = -halfL
				table.insert(tiles, {
					blockType = ITEM_NAME,
					cf = CFrame.new(baseX + offsetX, wallY, baseZ + offsetZ)
				})
			end

			-- Right wall (X+) - stacks directly above
			for gz = 0, length - 1 do
				local offsetX = halfW
				local offsetZ = (gz - (length - 1) / 2) * tileSize
				table.insert(tiles, {
					blockType = ITEM_NAME,
					cf = CFrame.new(baseX + offsetX, wallY, baseZ + offsetZ)
				})
			end

			-- Left wall (X-) - stacks directly above
			for gz = 0, length - 1 do
				local offsetX = -halfW
				local offsetZ = (gz - (length - 1) / 2) * tileSize
				table.insert(tiles, {
					blockType = ITEM_NAME,
					cf = CFrame.new(baseX + offsetX, wallY, baseZ + offsetZ)
				})
			end

			-- Corner fills - stacks directly above (no outward push)
			local corners = {
				{halfW,  halfL},
				{-halfW, halfL},
				{halfW,  -halfL},
				{-halfW, -halfL},
			}
			for _, corner in ipairs(corners) do
				table.insert(tiles, {
					blockType = ITEM_NAME,
					cf = CFrame.new(baseX + corner[1], wallY, baseZ + corner[2])
				})
			end
		end
		
		return tiles, nil, false -- returns: tiles, gridInfo, isPlatform
	end,
}

local TOTAL_BUILDS = #buildPatterns

-- ============================================
-- MASTER BLUEPRINT COMPILATION & AUTO REPAIR HANDLER
-- ============================================
blueprint = {}
platformKeySet = {}

local function generateBlueprint()
	blueprint = {}
	platformKeySet = {}

	-- Only include selected wall type if one is chosen
	local buildsToGenerate = {1}  -- Always include platform
	if selectedWallType == "1ST" then
		table.insert(buildsToGenerate, 2)
	elseif selectedWallType == "2ND" then
		table.insert(buildsToGenerate, 3)
	end

	-- Auto-adapt: iterate through selected builds
	for _, buildIndex in ipairs(buildsToGenerate) do
		local buildFunc = buildPatterns[buildIndex]
		
		if buildFunc then
			local tiles, gridInfo, isPlatform
			
			-- Call build function with appropriate parameters based on index
			if buildIndex == 1 then
				-- BUILD 1: Platform Floor
				tiles, gridInfo, isPlatform = buildFunc(PLATFORM_WIDTH, PLATFORM_LENGTH, trackedX, fixedCenter.Y, fixedCenter.Z, tileSize)
			elseif buildIndex == 2 or buildIndex == 3 then
				-- BUILD 2 or 3: Walls (1ST or 2ND)
				tiles, gridInfo, isPlatform = buildFunc(PLATFORM_WIDTH, PLATFORM_LENGTH, trackedX, fixedCenter.Y, fixedCenter.Z, tileSize, WALL_HEIGHT)
			else
				-- Additional builds
				tiles, gridInfo, isPlatform = buildFunc(PLATFORM_WIDTH, PLATFORM_LENGTH, trackedX, fixedCenter.Y, fixedCenter.Z, tileSize)
			end
			
			-- Compile tiles into master blueprint
			if tiles then
				for _, tile in ipairs(tiles) do
					table.insert(blueprint, tile)
					
					-- Register platform grid info if this is a platform build
					if isPlatform and gridInfo then
						local key = math.round(tile.cf.Position.X * 10) .. "_" .. math.round(tile.cf.Position.Y * 10) .. "_" .. math.round(tile.cf.Position.Z * 10)
						platformKeySet[key] = gridInfo[key]
					end
				end
			end
		end
	end
end

