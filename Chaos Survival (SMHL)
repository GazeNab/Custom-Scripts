-- ANIMATION PATTERNS TABLE
-- ============================================
local animationPatterns = {
	-- Pattern 1: Classic Chessboard
	function(gx, gz, width, length)
		if (gx + gz) % 2 == 0 then
			return CHESS_WHITE
		else
			return CHESS_BLACK
		end
	end,

	-- Pattern 2: Concentric Rings / Target
    function(gx, gz, width, length)
        local cx, cz = width / 2, length / 2
        local distance = math.floor(math.sqrt((gx - cx)^2 + (gz - cz)^2))
        return (distance % 2 == 0) and CHESS_WHITE or CHESS_BLACK
    end,

    -- Pattern 3: Diagonal Stripes
    function(gx, gz, width, length)
        return ((gx + gz) % 4 < 2) and CHESS_WHITE or CHESS_BLACK
    end,

    -- Pattern 4: Horizontal Stripes
    function(gx, gz, width, length)
        return (gz % 2 == 0) and CHESS_WHITE or CHESS_BLACK
    end,

    -- Pattern 5: Vertical Stripes
    function(gx, gz, width, length)
        return (gx % 2 == 0) and CHESS_WHITE or CHESS_BLACK
    end,

	-- Pattern 6: Center Diamond / Manhattan Distance
    function(gx, gz, width, length)
        local cx, cz = width / 2, length / 2
        local manhattanDist = math.abs(gx - cx) + math.abs(gz - cz)
        return (math.floor(manhattanDist) % 2 == 0) and CHESS_WHITE or CHESS_BLACK
    end,

    -- Pattern 7: Corner Borders / Outward Frames
    function(gx, gz, width, length)
        local distFromEdge = math.min(gx, gz, width - 1 - gx, length - 1 - gz)
        return (distFromEdge % 2 == 0) and CHESS_WHITE or CHESS_BLACK
    end,

    -- Pattern 8: 2x2 Sub-Grid Block Clusters
    function(gx, gz, width, length)
        local blockX = math.floor(gx / 2)
        local blockZ = math.floor(gz / 2)
        return ((blockX + blockZ) % 2 == 0) and CHESS_WHITE or CHESS_BLACK
    end,

    -- Pattern 9: Sine Wave / Ripple
    function(gx, gz, width, length)
        local cx, cz = width / 2, length / 2
        local dist = math.sqrt((gx - cx)^2 + (gz - cz)^2)
        local wave = math.sin(dist * 0.8)
        return (wave > 0) and CHESS_WHITE or CHESS_BLACK
    end,

    -- Pattern 10: Crosshair / Axis Divide
    function(gx, gz, width, length)
        local midX = math.floor(width / 2)
        local midZ = math.floor(length / 2)
        if gx == midX or gz == midZ then
            return CHESS_WHITE
        else
            return CHESS_BLACK
        end
    end,

	-- Pattern 11: Radial Circular Target
	function(gx, gz, width, length)
		local cx, cz = (width - 1) / 2, (length - 1) / 2
		local dist = math.floor(math.sqrt((gx - cx)^2 + (gz - cz)^2))
		local colors = {
			Color3.fromRGB(180, 50, 230),
			Color3.fromRGB(100, 20, 150),
			Color3.fromRGB(230, 150, 255)
		}
		return colors[(dist % #colors) + 1]
	end,

	-- Pattern 12: Four Quadrants
	function(gx, gz, width, length)
		local midX, midZ = width / 2, length / 2
		if gx < midX and gz < midZ then
			return Color3.fromRGB(240, 70, 70)   -- Top-Left Red
		elseif gx >= midX and gz < midZ then
			return Color3.fromRGB(70, 240, 70)   -- Top-Right Green
		elseif gx < midX and gz >= midZ then
			return Color3.fromRGB(70, 70, 240)   -- Bottom-Left Blue
		else
			return Color3.fromRGB(240, 240, 70)  -- Bottom-Right Yellow
		end
	end,

	-- Pattern 13: Diagonal Cross / X-Shape
	function(gx, gz, width, length)
		local normalizedX = gx / (width - 1)
		local normalizedZ = gz / (length - 1)
		if math.abs(normalizedX - normalizedZ) < 0.15 or math.abs(normalizedX - (1 - normalizedZ)) < 0.15 then
			return Color3.fromRGB(255, 215, 0)
		else
			return Color3.fromRGB(50, 20, 80)
		end
	end,

	-- Pattern 14: Polka Dots Matrix
	function(gx, gz, width, length)
		if gx % 3 == 1 and gz % 3 == 1 then
			return Color3.fromRGB(255, 50, 100)
		else
			return Color3.fromRGB(240, 240, 245)
		end
	end,

	-- Pattern 15: Rainbow Angular Sweep
	function(gx, gz, width, length)
		local angle = math.atan2(gz - (length / 2), gx - (width / 2))
		local hue = (angle + math.pi) / (2 * math.pi)
		return Color3.fromHSV(hue, 0.8, 0.9)
	end,

	-- Pattern 16: Interlocking Spiral Pattern
	function(gx, gz, width, length)
		local cx, cz = (width - 1) / 2, (length - 1) / 2
		local dist = math.sqrt((gx - cx)^2 + (gz - cz)^2)
		local angle = math.atan2(gz - cz, gx - cx)
		local spiralVal = math.floor(dist + (angle * 2)) % 2
		if spiralVal == 0 then
