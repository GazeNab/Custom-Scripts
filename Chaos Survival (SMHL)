-- ============================================
-- CORE BUILD FUNCTION - OPTIMIZED
-- ============================================
local function runBuild(startIndex)
	if buildInProgress then return end
	buildInProgress = true
	spawningActive  = true
	startIndex = startIndex or 1

	if startIndex == 1 then
		buildLabel.Text = "📐 Generating blueprint..."
		buildLabel.TextColor3 = Color3.fromRGB(220, 180, 60)
		generateBlueprint()
		-- Force refresh snapshot after generating blueprint
		snapshotExisting(true)
	end

	local surface = workspace:WaitForChild("Surface")

	for pass = 1, 2 do
		if not shouldContinue() then
			buildInProgress = false
			spawningActive = false
			return
		end

		local loopStart = (pass == 1) and startIndex or 1

		buildLabel.Text = "🛡 Pass " .. pass .. "/2..."
		buildLabel.TextColor3 = Color3.fromRGB(220, 180, 60)

		-- Snapshot ONCE per pass, not per iteration
		local existing = snapshotExisting(true)
		local repairedCount = 0
		local total = #blueprint

		for i = loopStart, total do
			if not shouldContinue() then
				buildResumeIndex = i
				buildInProgress = false
				spawningActive = false
				return
			end

			local entry = blueprint[i]
			local key = posToKey(entry.cf)

			-- Only check cache, no additional workspace scans
			if not existing[key] then
				buildRemote:InvokeServer(entry.blockType, entry.cf, surface)
				task.wait(Delay)
				-- Update cache immediately after placing block
				existing[key] = true
				repairedCount = repairedCount + 1
			end

			if i % 10 == 0 then
				buildLabel.Text = "🛡 Pass " .. pass .. " [" .. i .. "/" .. total .. "] +" .. repairedCount
			end
		end

		startIndex = 1
		if pass == 1 then task.wait(0.05) end
	end

	buildLabel.Text = "🔎 Final integrity scan..."
	buildLabel.TextColor3 = Color3.fromRGB(160, 220, 255)

	-- Force fresh snapshot for final scan
	local finalExisting = snapshotExisting(true)
	local finalRepaired = 0
	local finalTotal    = #blueprint

	for i, entry in ipairs(blueprint) do
		if not spawningActive then break end

		local key = posToKey(entry.cf)
		if not finalExisting[key] then
			buildRemote:InvokeServer(entry.blockType, entry.cf, surface)
			task.wait(Delay)
			-- Update cache immediately after placing block
			finalExisting[key] = true
			finalRepaired = finalRepaired + 1
		end

		if i % 10 == 0 then
			buildLabel.Text = "🔎 Scan [" .. i .. "/" .. finalTotal .. "] +" .. finalRepaired
		end
	end

	if finalRepaired > 0 then
		buildLabel.Text = "✅ Done! Fixed " .. finalRepaired .. " hole(s)."
	else
		buildLabel.Text = "✅ Complete! No holes found."
	end
	buildLabel.TextColor3 = Color3.fromRGB(100, 220, 150)
	buildInProgress = false
	spawningActive  = false
	pausedAt002 = false
	buildResumeIndex = 1

	resetManualBtn()

	if isPlaying then
		buildLabel.Text = "👀 Watching for " .. TARGET_TIMER .. "..."
		buildLabel.TextColor3 = Color3.fromRGB(100, 200, 220)
	end
end

