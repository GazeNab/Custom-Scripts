	-- Pattern 26: Hyperbolic Cross
	function(gx, gz, width, length)
		local cx, cz = (width - 1) / 2, (length - 1) / 2
		local val = math.abs((gx - cx) * (gz - cz))
		return (val % 4 < 2) and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(30, 30, 50)
