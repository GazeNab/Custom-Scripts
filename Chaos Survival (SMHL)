	-- Pattern 27: Center Outward Spiral
	function(gx, gz, width, length)
		local cx, cz = (width - 1) / 2, (length - 1) / 2
		local radius = math.sqrt((gx - cx)^2 + (gz - cz)^2)
		local angle = math.atan2(gz - cz, gx - cx)
		local check = math.floor(radius * 1.5 + angle * (3 / math.pi)) % 2
		return (check == 0) and Color3.fromRGB(255, 255, 100) or Color3.fromRGB(100, 50, 0)
