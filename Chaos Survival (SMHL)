	-- Pattern 22: Corner Inverted Quadrants
	function(gx, gz, width, length)
		local midX, midZ = width / 2, length / 2
		local isWhite = ((gx < midX and gz < midZ) or (gx >= midX and gz >= midZ))
		return isWhite and CHESS_WHITE or CHESS_BLACK
	end,

