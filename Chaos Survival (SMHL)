-- ============================================
-- TIMER DETECTION
-- ============================================
local timerKeywords = {"timer", "time", "countdown", "clock", "round"}

local function watchTimer(obj)
	statusLabel.Text = "✅ " .. obj.Name
	statusLabel.TextColor3 = Color3.fromRGB(100, 200, 140)
	timerValueLabel.Text = obj.Text

	obj:GetPropertyChangedSignal("Text"):Connect(function()
		local text = obj.Text
		timerValueLabel.Text = text

		if text == PAUSE_TIMER and buildInProgress then
			spawningActive = false
			pausedAt002 = true
			buildLabel.Text = "⏸ Paused at 0:02 — waiting for " .. TARGET_TIMER .. "..."
			buildLabel.TextColor3 = Color3.fromRGB(220, 180, 60)
		end

		if text == INCREMENT_TIMER and lastIncrementText ~= INCREMENT_TIMER then
			lastIncrementText = INCREMENT_TIMER
			trackedX = trackedX + X_INCREMENT
			local display = math.floor(trackedX * 100000 + 0.5) / 100000
			buildLabel.Text = "📍 X incremented → " .. tostring(display)
			buildLabel.TextColor3 = Color3.fromRGB(120, 200, 255)
			task.spawn(paintMyConcreteWalls)
		end
		if text ~= INCREMENT_TIMER then lastIncrementText = "" end

		if text == TIMERV1 and lastTimerV1Text ~= TIMERV1 then
			lastTimerV1Text = TIMERV1
			task.spawn(paintMyConcreteWalls)
		end
		if text ~= TIMERV1 then lastTimerV1Text = "" end

		if text == TIMERV2 and lastTimerV2Text ~= TIMERV2 then
			lastTimerV2Text = TIMERV2
			task.spawn(paintMyConcreteWalls)
		end
		if text ~= TIMERV2 then lastTimerV2Text = "" end

		if text == TIMERV3 and lastTimerV3Text ~= TIMERV3 then
			lastTimerV3Text = TIMERV3
			onAnimTimerFired("V3")
		end
		if text ~= TIMERV3 then lastTimerV3Text = "" end

		if text == TIMERV4 and lastTimerV4Text ~= TIMERV4 then
			lastTimerV4Text = TIMERV4
			onAnimTimerFired("V4")
		end
		if text ~= TIMERV4 then lastTimerV4Text = "" end

		if text == TARGET_TIMER and lastTriggerText ~= TARGET_TIMER then
			lastTriggerText = TARGET_TIMER

			if pausedAt002 then
				task.spawn(function()
					buildLabel.Text = "🔍 Checking blocks..."
					buildLabel.TextColor3 = Color3.fromRGB(180, 180, 60)
					task.wait(0.2)

					local blocksExist = anyBlueprintBlocksExist()
					pausedAt002 = false
					buildResumeIndex = 1

					if blocksExist then
						buildLabel.Text = "🔄 Disaster recovery — full repair from index 1..."
						buildLabel.TextColor3 = Color3.fromRGB(100, 200, 220)
						task.spawn(function()
							runBuild(1)
							resetManualBtn()
						end)
					else
						buildLabel.Text = "🔄 Blocks gone — restarting..."
						buildLabel.TextColor3 = Color3.fromRGB(220, 120, 60)
						task.spawn(function()
							runBuild(1)
							resetManualBtn()
						end)
					end
				end)

			elseif (isPlaying or isManualBuild) and not buildInProgress then
				task.spawn(function()
					runBuild(1)
					resetManualBtn()
				end)
			end
		end

		if text ~= TARGET_TIMER then
			lastTriggerText = ""
		end
	end)

	obj.AncestryChanged:Connect(function()
		if not obj:IsDescendantOf(game) then
			statusLabel.Text = "⚠️ Gone"
			statusLabel.TextColor3 = Color3.fromRGB(220, 160, 60)
			timerValueLabel.Text = "--"
		end
	end)
end

local function findTimerLabel()
	for _, obj in ipairs(playerGui:GetDescendants()) do
		if (obj:IsA("TextLabel") or obj:IsA("TextBox")) and obj ~= timerValueLabel then
			local nameLower = obj.Name:lower()
			for _, keyword in ipairs(timerKeywords) do
				if nameLower:find(keyword) then
					return obj
				end
			end
		end
	end
	return nil
end

local function startDetection()
	statusLabel.Text = "Scanning..."
	statusLabel.TextColor3 = Color3.fromRGB(130, 120, 160)

	local found = findTimerLabel()
	if found then
		watchTimer(found)
		return
	end

	playerGui.DescendantAdded:Connect(function(obj)
		if obj:IsA("TextLabel") or obj:IsA("TextBox") then
			local nameLower = obj.Name:lower()
			for _, keyword in ipairs(timerKeywords) do
				if nameLower:find(keyword) then
					watchTimer(obj)
					break
				end
			end
		end
	end)
end

task.wait(2)
startDetection()
