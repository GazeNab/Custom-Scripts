-- ============================================
-- HELPERS
-- ============================================
local function shouldContinue()
	if not spawningActive then return false end
	while isPaused and spawningActive do task.wait(0.1) end
	return spawningActive
end

local function posToKey(cf)
	local pos = cf.Position
	return math.round(pos.X * 10) .. "_" .. math.round(pos.Y * 10) .. "_" .. math.round(pos.Z * 10)
end

local function anyBlueprintBlocksExist()
	local existing = snapshotExisting(true) -- Force refresh for accuracy
	for _, entry in ipairs(blueprint) do
		local key = posToKey(entry.cf)
		if existing[key] then
			return true
		end
	end
	return false
end

-- ============================================
-- PAINT ALL MY CONCRETE WALLS (non-floor) - DEBOUNCED
-- ============================================
local function paintMyConcreteWalls()
	if not isPaintEnabled then return end
	
	local currentTime = tick()
	if (currentTime - lastPaintTime) < PAINT_DEBOUNCE then
		return
	end
	lastPaintTime = currentTime
	
	local placedBuildings = workspace:FindFirstChild("PlacedBuildings")
	if not placedBuildings then return end

	for _, v in pairs(placedBuildings:GetChildren()) do
		if v.Name == ITEM_NAME then
			local owner = v:FindFirstChild("PlayerOwner")
			if owner and owner.Value == player then
				local pos = v:GetPivot().Position
				local key = math.round(pos.X * 10) .. "_" .. math.round(pos.Y * 10) .. "_" .. math.round(pos.Z * 10)
				if platformKeySet[key] then
					continue
				end
				pcall(function()
					paintRemote:FireServer(v, PAINT_COLOR)
				end)
			end
		end
	end
end

